{
  "name": "@dealgo/middleware",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Bounded agent financial proposals and operator-approved test refunds, with JavaScript and MCP",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./client.d.ts",
